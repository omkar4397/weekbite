# --- Required in production (Vercel) -------------------------------------
# Neon Postgres connection string. Added automatically when you connect a
# Neon database from the Vercel Marketplace. Leave empty locally to use the
# embedded PGlite database in ./.pglite.
DATABASE_URL=

# Random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Protects /api/cron/refresh. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=

# --- Optional -------------------------------------------------------------
# Enables AI menu extraction + weekly summaries. Without it the app uses
# rule-based parsing and summaries.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Identify your scraper to website owners (put a contact URL/email in it).
# SCRAPER_USER_AGENT=WeekBiteBot/0.1 (+https://your-domain.example; you@example.com)
# MAX_RESTAURANTS_PER_LOCATION=25
# OVERPASS_URL=https://overpass-api.de/api/interpreter
